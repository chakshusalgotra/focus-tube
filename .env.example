# Host port exposed by Docker Compose.
FOCUSTUBE_PORT=3000

# Bind to loopback by default. Use 0.0.0.0 only when intentionally exposing
# FocusTube through a trusted network or HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1

# Additional comma-separated Host header values, including ports when present.
# Example: focus.example.com,focus.example.com:443
ALLOWED_HOSTS=

# Configure only when running behind a known reverse proxy.
# Example: loopback, linklocal, uniquelocal
TRUST_PROXY=

# Pinned yt-dlp package used while building the image.
YT_DLP_VERSION=2026.7.4