  "cards": [
    {
      "dot": "cyan",
      "title": "Dev deployment gate",
      "items": [
        "Tests and offline diagram evidence must pass. A fresh image starts without external network access and serves its assets, health and auth endpoints.",
        "WSL retains its Docker config. Dev deploys the exact validated commit with --wait --wait-timeout 120 before image cleanup."
      ]
    },
    {
      "dot": "amber",
      "title": "Independent environments",
      "items": [
        "Local/dev both bind host port 3002; production binds 3003. Compose project names isolate data and log volumes.",
        "Main remains on the existing workflow. Public HTTPS, provider availability, backups and user acceptance need separate verification."
      ]
    }
  ]
