  "cards": [
    {
      "dot": "cyan",
      "title": "Data ownership",
      "items": [
        "35 table declarations across core, chat, extension and analytics stores. Profiles use JSON; notes and conversations have independent revisions.",
        "Budget policy, cost accounting and request quotas survive learning imports and history deletion."
      ]
    },
    {
      "dot": "amber",
      "title": "Separate lifecycles",
      "items": [
        "Product analytics is opt-in. Operational logs use bounded route templates without prompts or note text.",
        "Dev and production have separate volumes. Optional downloads use temporary files and process memory."
      ]
    }
  ]
