    { "id": "capture-video", "from": "pending", "to": "metadata", "label": "POST videos", "variant": "emphasis" },
    { "id": "capture-commit", "from": "metadata", "to": "commit", "label": "Additive capture", "variant": "security" },
    { "id": "capture-receipt", "from": "commit", "to": "receipt", "label": "Server receipt", "variant": "emphasis" }
  ]
