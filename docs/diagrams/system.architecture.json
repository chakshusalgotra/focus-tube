  "cards": [
    {
      "dot": "cyan",
      "title": "Source-backed model",
      "items": [
        "One Node process owns the feature APIs; the module map expands learning, notes, chat budgets, capture, feedback and analytics.",
        "Official playback goes directly to YouTube. Metadata and permitted captions use separate server-side requests."
      ]
    },
    {
      "dot": "amber",
      "title": "Capability is not activation",
      "items": [
        "Chat/capture and analytics require configuration; the USD cap and six-hour request quotas have separate scopes.",
        "Hosted ingress uses the configured HTTPS tunnel. Container readiness probes use loopback; traces are authored flows, not telemetry."
      ]
    }
